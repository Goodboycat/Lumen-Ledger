  "_voices": "Character voice blurbs (cartoon hums, Zelda-style) — played by Audio.js on ui:dialogue:say when the dialogue box starts a line; speaker → voice_<speaker>, narrator → dlg_blip. solo:\"voice\" cuts the previous blurb; preload:true decodes them on unlock().",
  "ambience": {
    "_": "Looping beds mixed on the sfx bus (own ambGain). `always` beds run from game:start to game:title; `storm` beds fade in on storm:hit and out on storm:clear. Audio.js api.ambience(id,on,fade).",
    "surf": {
      "file": "amb/surf.ogg",
      "vol": 0.35,
      "when": "always"
    },
    "island_birds": {
      "file": "amb/island_birds.ogg",
      "vol": 0.3,
      "when": "always",
      "stormDuck": 0.15
    },
    "rain": {
      "file": "amb/rain.ogg",
      "vol": 0.55,
      "when": "storm"
    },
    "wind": {
      "file": "amb/wind.ogg",
      "vol": 0.45,
      "when": "storm"
    }
  },
