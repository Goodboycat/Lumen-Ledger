{"_": "48F + T2 guide cards. A card is reactive (`on` = bus event, `match` = payload filter, string ending in * = prefix) and/or curious (`target` = guide id a system registers in src/systems/curiosity.js or a [data-guide] element: shown when Pip walks up, `maxShows` times (default 3), until `doneOn`/`doneMatch` fires). A TAP on the thing always shows it. `point` = CSS selector for the hand. `group` = codex section. `priority` = queue order (higher first). ≤ 60 chars, every card has an icon. S59: `point` = array of selectors / 'world:<kind>' (hero coin jar jar:<id> stall till enemy stranger pier) — the cloud hand uses the first one that is on screen; `follow` = [{on, match}] bus events that mean the player did what the card says (card closes). Cards without follow/doneOn fade after `ttl` s of standing still. Moving never closes a card.", "ttl": 8, "lull": 25, "capInfo": 30, "capAct": 60,
 "cards": [
  {"id": "verb:move", "on": "tutor:hint", "match": {"id": "move"}, "icon": "joystick", "text": "Move Pip: WASD or tap the ground.", "textTouch": "Drag the stick to move Pip.", "demo": "move", "group": "verbs", "point": ["world:ahead"]},
  {"id": "verb:coin", "on": "tutor:hint", "match": {"id": "coin"}, "icon": "spark", "text": "Grab the coin ahead.", "group": "verbs", "point": ["world:coin"]},
  {"id": "verb:bonk", "on": "tutor:hint", "match": {"id": "bonk"}, "icon": "swords", "text": "Swing your sword: Space.", "group": "verbs", "point": [".ll-touch-btn.attack", "world:hero"]},
  {"id": "verb:stall", "on": "tutor:hint", "match": {"id": "stall"}, "icon": "hammer", "text": "Tap empty ground, pick a stall, Deploy.", "group": "verbs", "point": [".ll-build-placing .ll-btn.ok", ".ll-build-detail .ll-btn.deploy:not(:disabled)", ".ll-build-tab[data-cat=stall]:not(.on)", ".ll-build-grid .ll-card:not(.owned)", ".ll-build-toggle"], "teaches": "build-how"},
  {"id": "verb:deposit", "on": "tutor:hint", "match": {"id": "deposit"}, "icon": "jar", "text": "Carry it to the Save jar, press E.", "group": "verbs", "point": ["world:jar:save", "world:jar", ".ll-build-placing .ll-btn.ok", ".ll-build-detail .ll-btn.deploy:not(:disabled)", ".ll-build-grid .ll-card[data-id=jar_save]:not(.owned)", ".ll-build-tab[data-cat=jar]:not(.on)", ".ll-build-toggle"], "teaches": "jar-place"},
  {"id": "onBuildOpen", "on": "ui:build:open", "icon": "hammer", "text": "Tap a stall, then Deploy.", "point": [".ll-build-tab"], "group": "build", "follow": [{"on": "ui:build:tab"}, {"on": "build:enter"}, {"on": "ui:build", "match": {"action": "confirm"}}, {"on": "build:placed"}, {"on": "ui:build:close"}], "teaches": "build-how"},
  {"id": "onDemolish", "on": "ui:build", "match": {"action": "demolish"}, "icon": "warn", "text": "Careful — demolish sells for half.", "group": "build", "follow": [{"on": "build:removed"}, {"on": "ui:build:close"}]},
  {"id": "onDecorTab", "on": "ui:build:tab", "match": {"cat": "decor"}, "icon": "heart", "text": "Decor lifts the mood. Mood lifts sales.", "group": "build", "follow": [{"on": "build:placed"}, {"on": "ui:build:close"}]},
  {"id": "onFirstStall", "on": "build:placed", "match": {"id": "stall_*"}, "icon": "basket", "text": "Walk up to your stall to see the price.", "group": "build", "point": ["world:stall"], "follow": [{"on": "ui:price"}, {"on": "till:collect"}]},
  {"id": "onFirstCoin", "on": "eco:spark", "match": {"reason": "tip*"}, "icon": "coinbag", "text": "Your pouch is your Spend money. Jars keep the rest safe.", "point": ["world:jar", ".ll-build-tab[data-cat=jar]", ".ll-build-toggle"], "group": "money", "follow": [{"on": "ui:build:tab", "match": {"cat": "jar"}}, {"on": "jars:deposit"}], "teaches": "pouch"},
  {"id": "onJarsTab", "on": "ui:build:tab", "match": {"cat": "jar"}, "icon": "jar", "text": "Place each jar where you walk.", "group": "jars", "point": [".ll-build-placing .ll-btn.ok", ".ll-build-detail .ll-btn.deploy:not(:disabled)", ".ll-build-grid .ll-card:not(.owned)", "world:jar"], "follow": [{"on": "build:placed"}, {"on": "ui:build:close"}], "teaches": "jar-place"},
  {"id": "jar:add", "icon": "jar", "text": "Add your new jars: Build, Jars tab.", "group": "jars", "maxShows": 12, "priority": 3, "point": ["^.ll-build-tab[data-cat=jar]", ".ll-build-toggle"], "follow": [{"on": "build:placed", "match": {"id": "jar_*"}}, {"on": "ui:build:tab", "match": {"cat": "jar"}}]},
  {"id": "onFirstDeposit", "on": "jars:deposit", "icon": "shield", "text": "Saved Spark earns. Pouch Spark gets spilled.", "group": "jars", "point": [".ll-jars:not(.collapsed) .ll-jar.has-bal", ".ll-jars:not(.collapsed) .ll-jars-head"]},
  {"id": "onDebtPay", "on": "tut:pay", "icon": "payhand", "text": "Debt grows every Ledger. Tap PAY to pay it down.", "group": "money", "teaches": "pay", "point": [".ll-spark-pay:not(:disabled)", ".ll-spark-pay", "[data-guide=\"hud:debt\"]"], "priority": 4, "follow": [{"on": "game:repaid"}, {"on": "ui:repay"}], "doneOn": "game:repaid"},
  {"id": "onWave", "on": "enemy:wave", "icon": "swords", "text": "Collectors chase coins. Hit them or outrun.", "group": "threats", "point": ["world:enemy"], "follow": [{"on": "combat:hit"}], "teaches": "collectors"},
  {"id": "onSeason2", "on": "eco:season", "match": {"season": 2}, "icon": "calendar", "text": "Each season: one HOT and one COLD good.", "group": "market"},
  {"id": "onLocked", "on": "jars:locked", "icon": "lock", "text": "Invest is locked until the Ledger.", "group": "jars", "teaches": "invest-locked"},
  {"id": "onCuriosityLull", "on": null, "icon": "point", "text": "Tap empty ground to build.", "group": "build", "point": [".ll-build-toggle"], "follow": [{"on": "ui:build:open"}, {"on": "ui:tap:land"}], "teaches": "build-how"},
  {"id": "jar:save", "icon": "jar", "text": "Save jar: 10 ✦ in, +5 % each Ledger.", "group": "jars", "target": "jar:save", "doneOn": "jars:deposit", "doneMatch": {"jar": "save"}, "priority": 2, "point": ["world:jar:save"]},
  {"id": "jar:protect", "icon": "umbrella", "text": "Protect jar: eats storms and bad luck.", "group": "jars", "target": "jar:protect", "doneOn": "jars:deposit", "doneMatch": {"jar": "protect"}, "priority": 2, "point": ["world:jar:protect"], "teaches": "protect-jar"},
  {"id": "jar:invest", "icon": "chart", "text": "Invest jar: grows most, locked till the Ledger.", "group": "jars", "target": "jar:invest", "doneOn": "jars:deposit", "doneMatch": {"jar": "invest"}, "priority": 2, "point": ["world:jar:invest"], "teaches": "invest-locked"},
  {"id": "jar:withdraw", "icon": "undo", "text": "Hold E (or tap the arrow) to take ✦ back.", "textTouch": "Tap the arrow to take ✦ back.", "group": "jars", "target": "jar:withdraw", "doneOn": "jars:withdraw", "point": [".ll-jars:not(.collapsed) .ll-jar.has-bal .ll-jar-wd", ".ll-jars:not(.collapsed) .ll-jar:not([hidden]) .ll-jar-wd", ".ll-jars .ll-jars-head"]},
  {"id": "stall:any", "icon": "basket", "text": "Your stall. Customers pay into the till.", "group": "market", "target": "stall:any", "doneOn": "till:collect", "priority": 1, "point": ["world:stall"]},
  {"id": "till:coins", "icon": "coinbag", "text": "Coins in the till. Walk over to collect.", "group": "market", "target": "till:coins", "doneOn": "till:collect", "priority": 3, "point": ["world:till"]},
  {"id": "sign:price", "icon": "magnify", "text": "Sign: E raises the price, hold E lowers it.", "group": "market", "target": "sign:price", "doneOn": "ui:price"},
  {"id": "stall:upgrade", "icon": "upgrade", "text": "Tap your stall, then press Upgrade.", "group": "market", "target": "stall:upgrade", "doneOn": "build:upgraded", "point": ["world:stall"]},
  {"id": "cust:want", "icon": "heart", "text": "A bubble shows what a Glimmer wants. Build it.", "group": "market", "on": "story:bark", "match": {"kind": "want"}, "point": [".ll-build-toggle"], "follow": [{"on": "ui:build:open"}, {"on": "build:placed"}]},
  {"id": "hud:pouch", "icon": "coinbag", "text": "Pouch: your cash. Collectors can spill it.", "group": "money", "target": "hud:pouch", "teaches": "pouch"},
  {"id": "hud:debt", "icon": "anchor", "text": "Debt grows every Ledger. PAY lowers it.", "group": "money", "target": "hud:debt", "teaches": "pay"},
  {"id": "hud:season", "icon": "calendar", "text": "Season clock. The Ledger comes at the end.", "group": "money", "target": "hud:season"},
  {"id": "hud:focus", "icon": "focus", "text": "Focus pays for powers. Fair habits refill it.", "group": "money", "target": "hud:focus"},
  {"id": "hud:boons", "icon": "boon", "text": "Boons: one pick per Ledger. Each has a price.", "group": "money", "target": "hud:boons"},
  {"id": "hud:rep", "icon": "star", "text": "Reputation: fair prices raise it.", "group": "money", "target": "hud:rep"},
  {"id": "enemy:collector", "icon": "swords", "text": "Collectors steal coins. Hit them or outrun.", "group": "threats", "target": "enemy:collector", "doneOn": "combat:hit", "doneMatch": {"enemy": true}, "priority": 3, "point": ["world:enemy"], "teaches": "collectors"},
  {"id": "enemy:baron", "icon": "anchor", "text": "The Baron. Loans look nice. Interest bites.", "group": "threats", "target": "enemy:baron", "doneOn": "pier:done", "priority": 3, "point": ["world:pier", "world:enemy"]},
  {"id": "event:storm", "icon": "stormmark", "text": "Storm coming. A Protect jar softens it.", "group": "threats", "on": "novelty:start", "match": {"id": "stormWarning"}, "doneOn": "jars:deposit", "point": ["world:jar:protect", ".ll-build-toggle"], "teaches": "protect-jar"},
  {"id": "npc:stranger", "icon": "eyes", "text": "A stranger wants to talk. Walk up.", "group": "people", "target": "npc:stranger", "doneOn": "eco:scam", "priority": 3, "point": ["world:stranger"]},
  {"id": "crew:tallyOwl", "icon": "owl", "text": "Tally Owl: Save jar earns +1 % more.", "group": "crew", "target": "crew:tallyOwl", "on": "sandbox:hired", "match": {"type": "tallyOwl"}},
  {"id": "crew:packMole", "icon": "basket", "text": "Pack Mole: stall upkeep −20 %.", "group": "crew", "target": "crew:packMole", "on": "sandbox:hired", "match": {"type": "packMole"}},
  {"id": "crew:sparkBee", "icon": "bolt", "text": "Spark Bee: every stall sells +10 %.", "group": "crew", "target": "crew:sparkBee", "on": "sandbox:hired", "match": {"type": "sparkBee"}},
  {"id": "crew:guardTortoise", "icon": "shield", "text": "Guard Tortoise: Protect jar absorbs more.", "group": "crew", "target": "crew:guardTortoise", "on": "sandbox:hired", "match": {"type": "guardTortoise"}},
  {"id": "crew:scoutFox", "icon": "eyes", "text": "Scout Fox: sniffs out Too-Good Deals.", "group": "crew", "target": "crew:scoutFox", "on": "sandbox:hired", "match": {"type": "scoutFox"}},
  {"id": "crew:gardenerSnail", "icon": "sprout", "text": "Gardener Snail: reputation grows a bit.", "group": "crew", "target": "crew:gardenerSnail", "on": "sandbox:hired", "match": {"type": "gardenerSnail"}},
  {"id": "power:coinMagnetDash", "icon": "dash", "text": "Dash to coins and tills. Pulls them in.", "whenHint": "No coins near. Dash to a till.", "group": "powers", "on": "sandbox:ability", "match": {"name": "coinMagnetDash"}},
  {"id": "power:bubbleShield", "icon": "shield", "text": "Next bad event costs 0. Lasts 30 s.", "whenHint": "Shield is ready. Use at the storm warning.", "group": "powers", "on": "sandbox:ability", "match": {"name": "bubbleShield"}},
  {"id": "power:growthStomp", "icon": "upgrade", "text": "Stalls sell more for 12 s. Use when busy.", "whenHint": "No stalls to boost. Build one.", "group": "powers", "on": "sandbox:ability", "match": {"name": "growthStomp"}},
  {"id": "power:ledgerFlash", "icon": "bulb", "text": "Shows a deal's TRUE cost. Use near a stranger.", "whenHint": "No deal open. Use near a stranger.", "group": "powers", "on": "sandbox:ability", "match": {"name": "ledgerFlash"}},
  {"id": "power:haggleShout", "icon": "megaphone", "text": "Next sale pays +10 %. Use with customers.", "whenHint": "No customers. Wait by a stall.", "group": "powers", "on": "sandbox:ability", "match": {"name": "haggleShout"}},
