{
  "_": "48F + T2 guide cards. A card is reactive (`on` = bus event, `match` = payload filter, string ending in * = prefix) and/or curious (`target` = guide id a system registers in src/systems/curiosity.js or a [data-guide] element: shown when Pip walks up, `maxShows` times (default 3), until `doneOn`/`doneMatch` fires). A TAP on the thing always shows it. `point` = CSS selector for the hand. `group` = codex section. `priority` = queue order (higher first). ≤ 60 chars, every card has an icon.",
  "ttl": 8,
  "lull": 25,
  "cards": [
    {"id": "verb:move", "on": "tutor:hint", "match": {"id": "move"}, "icon": "dash", "text": "Move Pip: WASD or tap the ground.", "group": "verbs"},
    {"id": "verb:coin", "on": "tutor:hint", "match": {"id": "coin"}, "icon": "spark", "text": "Grab the coin ahead.", "group": "verbs"},
    {"id": "verb:bonk", "on": "tutor:hint", "match": {"id": "bonk"}, "icon": "swords", "text": "Swing your sword: Space.", "group": "verbs"},
    {"id": "verb:stall", "on": "tutor:hint", "match": {"id": "stall"}, "icon": "hammer", "text": "Tap empty ground, pick a stall, Deploy.", "group": "verbs"},
    {"id": "verb:deposit", "on": "tutor:hint", "match": {"id": "deposit"}, "icon": "jar", "text": "Carry it to the Save jar, press E.", "group": "verbs"},
    {"id": "onBuildOpen", "on": "ui:build:open", "icon": "hammer", "text": "Tap a stall, then Deploy.", "point": ".ll-build-tab", "group": "build"},
    {"id": "onDemolish", "on": "ui:build", "match": {"action": "demolish"}, "icon": "warn", "text": "Careful — demolish sells for half.", "group": "build"},
    {"id": "onDecorTab", "on": "ui:build:tab", "match": {"cat": "decor"}, "icon": "heart", "text": "Decor lifts the mood. Mood lifts sales.", "group": "build"},
    {"id": "onFirstStall", "on": "build:placed", "match": {"id": "stall_*"}, "icon": "basket", "text": "Walk up to your stall to see the price.", "group": "build"},
    {"id": "onFirstCoin", "on": "eco:spark", "match": {"reason": "tip*"}, "icon": "coinbag", "text": "Coins go in the pouch. Jars keep them safe.", "point": ".ll-build-tab[data-cat=jar]", "group": "money"},
    {"id": "onJarsTab", "on": "ui:build:tab", "match": {"cat": "jar"}, "icon": "jar", "text": "One of each. Place them where you walk.", "group": "jars"},
    {"id": "onFirstDeposit", "on": "jars:deposit", "icon": "shield", "text": "Saved Spark earns. Pouch Spark gets spilled.", "group": "jars"},
    {"id": "onWave", "on": "enemy:wave", "icon": "swords", "text": "Collectors chase coins. Hit them or outrun.", "group": "threats"},
    {"id": "onSeason2", "on": "eco:season", "match": {"season": 2}, "icon": "calendar", "text": "Each season: one HOT and one COLD good.", "group": "market"},
    {"id": "onLocked", "on": "jars:locked", "icon": "lock", "text": "Invest is locked until the Ledger.", "group": "jars"},
    {"id": "onCuriosityLull", "on": null, "icon": "point", "text": "Tap empty ground to build.", "group": "build"},
    {"id": "jar:spend", "icon": "coinbag", "text": "Spend jar: daily money. Tap it to put 10 ✦ in.", "group": "jars", "target": "jar:spend", "doneOn": "jars:deposit", "doneMatch": {"jar": "spend"}, "priority": 2},
    {"id": "jar:save", "icon": "jar", "text": "Save jar: 10 ✦ in, +5 % each Ledger.", "group": "jars", "target": "jar:save", "doneOn": "jars:deposit", "doneMatch": {"jar": "save"}, "priority": 2},
    {"id": "jar:protect", "icon": "umbrella", "text": "Protect jar: eats storms and bad luck.", "group": "jars", "target": "jar:protect", "doneOn": "jars:deposit", "doneMatch": {"jar": "protect"}, "priority": 2},
    {"id": "jar:invest", "icon": "chart", "text": "Invest jar: grows most, locked till the Ledger.", "group": "jars", "target": "jar:invest", "doneOn": "jars:deposit", "doneMatch": {"jar": "invest"}, "priority": 2},
    {"id": "jar:withdraw", "icon": "undo", "text": "Hold E (or tap the arrow) to take ✦ back.", "group": "jars", "target": "jar:withdraw", "doneOn": "jars:withdraw"},
    {"id": "stall:any", "icon": "basket", "text": "Your stall. Customers pay into the till.", "group": "market", "target": "stall:any", "doneOn": "till:collect", "priority": 1},
    {"id": "till:coins", "icon": "coinbag", "text": "Coins in the till. Walk over to collect.", "group": "market", "target": "till:coins", "doneOn": "till:collect", "priority": 3},
    {"id": "sign:price", "icon": "magnify", "text": "Sign: E raises the price, hold E lowers it.", "group": "market", "target": "sign:price", "doneOn": "ui:price"},
    {"id": "stall:upgrade", "icon": "upgrade", "text": "Tap your stall, then press Upgrade.", "group": "market", "target": "stall:upgrade", "doneOn": "build:upgraded"},
    {"id": "cust:want", "icon": "heart", "text": "A bubble shows what a Glimmer wants. Build it.", "group": "market", "on": "story:bark", "match": {"kind": "want"}},
    {"id": "hud:pouch", "icon": "coinbag", "text": "Pouch: your cash. Collectors can spill it.", "group": "money", "target": "hud:pouch"},
    {"id": "hud:debt", "icon": "anchor", "text": "Debt grows every Ledger. PAY lowers it.", "group": "money", "target": "hud:debt"},
    {"id": "hud:season", "icon": "calendar", "text": "Season clock. The Ledger comes at the end.", "group": "money", "target": "hud:season"},
    {"id": "hud:rep", "icon": "star", "text": "Reputation: fair prices raise it.", "group": "money", "target": "hud:rep"},
    {"id": "enemy:collector", "icon": "swords", "text": "Collectors steal coins. Hit them or outrun.", "group": "threats", "target": "enemy:collector", "doneOn": "combat:hit", "doneMatch": {"enemy": true}, "priority": 3},
    {"id": "enemy:baron", "icon": "anchor", "text": "The Baron. Loans look nice. Interest bites.", "group": "threats", "target": "enemy:baron", "doneOn": "pier:done", "priority": 3},
    {"id": "event:storm", "icon": "umbrella", "text": "Storm coming. A Protect jar softens it.", "group": "threats", "on": "novelty:start", "match": {"id": "stormWarning"}, "doneOn": "jars:deposit"},
    {"id": "npc:stranger", "icon": "eyes", "text": "A stranger wants to talk. Walk up.", "group": "people", "target": "npc:stranger", "doneOn": "eco:scam", "priority": 3},
    {"id": "crew:tallyOwl", "icon": "owl", "text": "Tally Owl: Save jar earns +1 % more.", "group": "crew", "target": "crew:tallyOwl", "on": "sandbox:hired", "match": {"type": "tallyOwl"}},
    {"id": "crew:packMole", "icon": "basket", "text": "Pack Mole: stall upkeep −20 %.", "group": "crew", "target": "crew:packMole", "on": "sandbox:hired", "match": {"type": "packMole"}},
    {"id": "crew:sparkBee", "icon": "bolt", "text": "Spark Bee: every stall sells +10 %.", "group": "crew", "target": "crew:sparkBee", "on": "sandbox:hired", "match": {"type": "sparkBee"}},
    {"id": "crew:guardTortoise", "icon": "shield", "text": "Guard Tortoise: Protect jar absorbs more.", "group": "crew", "target": "crew:guardTortoise", "on": "sandbox:hired", "match": {"type": "guardTortoise"}},
    {"id": "crew:scoutFox", "icon": "eyes", "text": "Scout Fox: sniffs out Too-Good Deals.", "group": "crew", "target": "crew:scoutFox", "on": "sandbox:hired", "match": {"type": "scoutFox"}},
    {"id": "crew:gardenerSnail", "icon": "sprout", "text": "Gardener Snail: reputation grows a bit.", "group": "crew", "target": "crew:gardenerSnail", "on": "sandbox:hired", "match": {"type": "gardenerSnail"}},
    {"id": "power:coinMagnetDash", "icon": "dash", "text": "Magnet: dash pulls coins and tills to you.", "group": "powers", "on": "sandbox:ability", "match": {"name": "coinMagnetDash"}},
    {"id": "power:bubbleShield", "icon": "shield", "text": "Shield: next bad event costs 0. Lasts 30 s.", "group": "powers", "on": "sandbox:ability", "match": {"name": "bubbleShield"}},
    {"id": "power:growthStomp", "icon": "upgrade", "text": "Stomp: stalls sell more for 12 s.", "group": "powers", "on": "sandbox:ability", "match": {"name": "growthStomp"}},
    {"id": "power:ledgerFlash", "icon": "bulb", "text": "Flash: shows a deal's TRUE cost. Use near a stranger.", "group": "powers", "on": "sandbox:ability", "match": {"name": "ledgerFlash"}},
    {"id": "power:haggleShout", "icon": "megaphone", "text": "Haggle: next sale pays more. Use with customers.", "group": "powers", "on": "sandbox:ability", "match": {"name": "haggleShout"}},
    {"id": "power:fogSweep", "icon": "broom", "text": "Sweep: pushes Debt Fog back at its edge.", "group": "powers", "on": "sandbox:ability", "match": {"name": "fogSweep"}},
    {"id": "power:locked", "icon": "lock", "text": "Locked. Earn ★ at the Ledger.", "group": "powers", "on": "ability:locked"}
  ]
}
